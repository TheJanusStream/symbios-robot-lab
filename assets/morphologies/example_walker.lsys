omega: O(head) Si f(0 - head) -(270) G(10 ^ (2 ^ min(6, max(1, round(trunk / link)))), 10, link, max(girth, 0.3), min(yawl, 1.2), min(yawr, 1.2), min(yawl, 1.2), min(yawr, 1.2), 1000, 10 ^ (2 ^ min(3, max(1, round(segs)))), leg / min(3, max(1, round(segs))), shank, reach, min(fore, 0.75), min(aft, 0.75), min(bend, 1), min(bend, 1), 0)
G(n, z, m, r, dl, dh, fl, fh, k, c, a, b, w, el, eh, gl, gh, k2) : n > z -> [ &(90) f(w) &(-90) -(90) /(90) G(c, z, a, b, el, eh, gl, gh, k2, z, 0, 0, 0, 0, 0, 0, 0, 1000) ] [ &(-90) f(w) &(90) -(90) /(90) G(c, z, a, b, el, eh, gl, gh, k2, z, 0, 0, 0, 0, 0, 0, 0, 1000) ] Jl(-dl, dh, 4000, 5) J K(m, r) T(n, k) G(sqrt(n), z, m, r, fl, fh, fl, fh, k, c, a, b, w, el, eh, gl, gh, k2)
T(n, k) : max(n, k) <= 300 -> St
